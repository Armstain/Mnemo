<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <!-- Reminders fire at the minute they were set for. Without this, Android 12+
       only allows inexact alarms, which battery saving can hold back for hours.
       On Android 14+ the person grants it in "Alarms & reminders"; the reminder
       check screen takes them there. -->
  <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
</manifest>
