{
  "expo": {
    "name": "Mnemo",
    "slug": "mnemo-ai",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "mnemo",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mnemo.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "monochromeImage": "./assets/images/adaptive-icon-monochrome.png",
        "backgroundColor": "#FAF8F3"
      },
      "package": "com.mnemo.app",
      "permissions": [
        "RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120,
          "resizeMode": "contain",
          "backgroundColor": "#FAF8F3",
          "dark": {
            "image": "./assets/images/splash-icon-dark.png",
            "backgroundColor": "#121310"
          }
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Mnemo listens while you talk so it can write your note. The audio is never saved."
        }
      ],
      "expo-secure-store",
      [
        "expo-build-properties",
        {
          "android": {
            "enableOnBackInvokedCallback": true
          }
        }
      ],
      "expo-font",
      "expo-sqlite",
      "expo-notifications",
      "expo-quick-actions",
      "./plugins/with-shortcut-icons",
      "expo-asset",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Mnemo listens while you talk so it can write your note. The audio is never saved.",
          "speechRecognitionPermission": "Mnemo turns what you say into text on your phone. The audio is never saved.",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox",
            "com.google.android.as"
          ]
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Mnemo adds the photos you choose to your notes. They stay on your phone.",
          "cameraPermission": "Mnemo adds the photos you take to your notes. They stay on your phone."
        }
      ],
      [
        "expo-share-intent",
        {
          "androidIntentFilters": [
            "text/*",
            "image/*"
          ],
          "androidMultiIntentFilters": [
            "image/*"
          ],
          "disableIOS": true
        }
      ],
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "Capture",
              "label": "Mnemo",
              "description": "Record or write a note, and see what to pick up next",
              "minWidth": "250dp",
              "minHeight": "110dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "previewImage": "./assets/images/widget-preview.png",
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
